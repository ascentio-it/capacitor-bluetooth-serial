{
  "name": "@ascentio-it/capacitor-bluetooth-serial",
  "version": "8.0.0",
  "description": "Capacitor Bluetooth Serial Plugin",
  "main": "dist/plugin.cjs.js",
  "module": "dist/esm/index.js",
  "types": "dist/esm/index.d.ts",
  "unpkg": "dist/plugin.js",
  "files": [
    "android/src/main/",
    "android/build.gradle",
    "dist/",
    "ios/Plugin/",
    "asc_CapacitorBluetoothSerial.podspec"
  ],
  "scripts": {
    "verify": "npm run verify:ios && npm run verify:android && npm run verify:web",
    "verify:ios": "cd ios && pod install && xcodebuild -workspace Plugin.xcworkspace -scheme Plugin -destination generic/platform=iOS && cd ..",
    "verify:android": "cd android && ./gradlew clean build test && cd ..",
    "verify:web": "npm run build",
    "lint": "eslint . --ext .ts,.js",
    "format": "prettier --write .",
    "eslint": "eslint . --ext .ts,.js --ignore-pattern dist/",
    "prettier": "prettier \"**/*.{css,html,ts,js,java}\" --plugin=prettier-plugin-java",
    "swiftlint": "node-swiftlint",
    "docgen": "docgen --api BluetoothSerialPlugin --output-readme README.md --output-json dist/docs.json",
    "build": "npm run clean && npm run docgen && tsc && rollup -c rollup.config.mjs",
    "clean": "rimraf ./dist",
    "watch": "tsc --watch",
    "prepublishOnly": "npm run build",
    "publish:cocoapod": "pod trunk push ./asc_CapacitorBluetoothSerial.podspec --allow-warnings"
  },
  "author": "Gerson Groth",
  "license": "MIT",
  "devDependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/docgen": "^0.3.1",
    "@capacitor/ios": "^8.0.0",
    "@eslint/js": "^9.39.2",
    "@ionic/eslint-config": "^0.4.0",
    "@ionic/prettier-config": "^4.0.0",
    "@ionic/swiftlint-config": "^2.0.0",
    "@types/node": "^25.2.0",
    "eslint": "^8.57.1",
    "globals": "^17.3.0",
    "prettier": "^3.8.1",
    "prettier-plugin-java": "^2.7.7",
    "rimraf": "^6.1.0",
    "rollup": "^4.53.2",
    "swiftlint": "^2.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0"
  },
  "prettier": "@ionic/prettier-config",
  "swiftlint": "@ionic/swiftlint-config",
  "eslintConfig": {
    "extends": "@ionic/eslint-config/recommended"
  },
  "capacitor": {
    "ios": {
      "src": "ios"
    },
    "android": {
      "src": "android"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "capacitor",
    "plugin",
    "native"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ascentio-it/capacitor-bluetooth-serial"
  },
  "bugs": {
    "url": "https://github.com/ascentio-it/capacitor-bluetooth-serial/issues"
  }
}
